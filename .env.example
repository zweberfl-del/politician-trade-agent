# === Discord ===
DISCORD_BOT_TOKEN=your-discord-bot-token
# Numeric channel ID (right-click the channel with Developer Mode enabled)
ALERT_CHANNEL_ID=0

# === Feature Toggles ===
ENABLE_ALERTS=true
ENABLE_AUTO_TRADE=false
ENABLE_SELL_MIRROR=false
PAPER_TRADING=true
ENABLE_WEEKLY_DIGEST=false

# === Polling ===
POLL_INTERVAL_MINUTES=30

# === Ingestion ===
# First run with an empty database ingests history without posting alerts
BACKFILL_SILENT=true
# Fetch per-trade detail from Senate PTR pages / House PTR PDFs
PARSE_FILING_DETAILS=true
MAX_FILINGS_PER_CYCLE=25
# Party/state/committee enrichment from the congress-legislators dataset
ENABLE_ENRICHMENT=true

# === Options Flow / Market Data ===
# Scan options chains for unusual activity during market hours and post alerts
ENABLE_FLOW_ALERTS=false
FLOW_WATCHLIST=SPY,QQQ,IWM,AAPL,MSFT,NVDA,AMZN,META,TSLA,GOOGL
FLOW_MIN_PREMIUM_USD=250000
FLOW_POLL_MINUTES=10
# Chain source: "auto" uses Tradier real-time OPRA quotes whenever
# TRADIER_API_KEY is set (free Tradier brokerage account), otherwise Yahoo
# (delayed ~15 min, no key). Force with "yahoo" or "tradier".
OPTIONS_PROVIDER=auto
TRADIER_API_KEY=
# Use https://sandbox.tradier.com for sandbox keys (delayed data)
TRADIER_BASE_URL=https://api.tradier.com

# === Prediction Markets (Polymarket) ===
# Alert on unusual bets: fresh wallets placing size, proven winners placing
# size, and longshot conviction. Public data, no key required.
ENABLE_PREDICTION_ALERTS=false
PREDICTION_MIN_BET_USD=10000
PREDICTION_POLL_MINUTES=5

# === Web Dashboard ===
# Browser view of trades, flow, GEX, and dark pool data (responsive/mobile)
ENABLE_DASHBOARD=false
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8080
# Shared secret gating the dashboard + APIs. Empty = no auth (trusted LAN
# only). Sign in once via /?token=<value>; API calls: Authorization: Bearer
DASHBOARD_AUTH_TOKEN=

# === Alert Filters (all optional) ===
# Suppress channel alerts below this disclosed amount (lower bound), 0 = off
ALERT_MIN_AMOUNT_USD=0
# Comma-separated tickers to alert on; empty = all tickers
ALERT_TICKER_WATCHLIST=
# Comma-separated party codes (D,R,I); empty = all parties
ALERT_PARTY_FILTER=

# === Trading ===
TRADE_AMOUNT_USD=500

# === Alpaca (optional — only needed if ENABLE_AUTO_TRADE=true) ===
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# === Data Sources (optional) ===
# NOTE: Finnhub's congressional-trading endpoint requires a PAID plan;
# leave empty unless you have premium access.
FINNHUB_API_KEY=

# === Storage ===
DATABASE_PATH=trades.db
# Directory for cached downloads (House FD ZIPs); empty disables caching
CACHE_DIR=.cache
