# === Discord ===
DISCORD_BOT_TOKEN=your-discord-bot-token
ALERT_CHANNEL_ID=your-discord-channel-id

# === Feature Toggles ===
ENABLE_ALERTS=true
ENABLE_AUTO_TRADE=false
ENABLE_SELL_MIRROR=false
PAPER_TRADING=true

# === Polling ===
POLL_INTERVAL_MINUTES=30

# === Trading ===
TRADE_AMOUNT_USD=500

# === Alpaca (optional — only needed if ENABLE_AUTO_TRADE=true) ===
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_BASE_URL=https://paper-api.alpaca.markets
