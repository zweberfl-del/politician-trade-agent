# systemd unit for the politician-trade-agent Discord bot.
#
# Install:
#   sudo cp deploy/politician-trade-agent.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now politician-trade-agent
#
# Assumes the repo is cloned at /opt/politician-trade-agent with a venv in
# .venv and secrets in /opt/politician-trade-agent/.env (chmod 600).

[Unit]
Description=Politician trade tracking and mirroring Discord bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=trader
WorkingDirectory=/opt/politician-trade-agent
ExecStart=/opt/politician-trade-agent/.venv/bin/python -m src.main
Restart=on-failure
RestartSec=30

# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/opt/politician-trade-agent

[Install]
WantedBy=multi-user.target
